#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v gradle >/dev/null 2>&1; then
  exec gradle --project-dir "$SCRIPT_DIR" "$@"
fi

echo "Gradle is not installed or not available on PATH." >&2
echo "Install Gradle (for example: sudo apt-get install gradle) or use a proper Android project generated by React Native." >&2
exit 127
